<UserControl x:Class="FollowBot.Views.Tabs.GeneralTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:settingsPath="clr-namespace:FollowBot"
             mc:Ignorable="d"
             d:DataContext="{x:Static settingsPath:FollowBotSettings.Instance}">
    <UserControl.Resources>
        <ResourceDictionary>
            <settingsPath:EnumToBoolConverter x:Key="EnumToBoolConverter"/>
            <settingsPath:InverseBoolConverter x:Key="InverseBoolConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- Auto-Login Settings -->
            <Expander Header="Auto-Login Settings" IsExpanded="False" Margin="5">
                <StackPanel Margin="5">
                    <CheckBox Content="Enable Auto-Login"
                              IsChecked="{Binding Login.AutoLoginEnabled, Mode=TwoWay}"
                              Margin="5"
                              ToolTip="Automatically log in and select a character when the bot starts at the login screen."/>

                    <Grid Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="Character Name:" VerticalAlignment="Center"
                               ToolTip="Leave empty for smart selection (auto-picks current league character). Set to use a specific character, including private leagues."/>
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Text="{Binding Login.CharacterName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="3" VerticalAlignment="Center"
                                 ToolTip="Leave empty for smart selection (auto-picks current league character). Set to use a specific character, including private leagues."/>

                        <Label Grid.Row="1" Grid.Column="0" Content="Email:" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 Text="{Binding Login.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="3" VerticalAlignment="Center"
                                 ToolTip="Your PoE account email. Used if 'remember me' credentials are not available."/>

                        <Label Grid.Row="2" Grid.Column="0" Content="Password:" VerticalAlignment="Center"/>
                        <PasswordBox x:Name="LoginPasswordBox" Grid.Row="2" Grid.Column="1"
                                     Margin="3" VerticalAlignment="Center"
                                     PasswordChanged="LoginPasswordBox_PasswordChanged"
                                     ToolTip="Your PoE password. Encrypted with Windows DPAPI and stored securely. Only used if 'remember me' credentials fail."/>
                    </Grid>

                    <TextBlock Text="Credentials are only needed if PoE's 'remember me' isn't active. Password is encrypted with Windows DPAPI."
                               Margin="5,5,5,0" FontSize="10" FontStyle="Italic" Foreground="Gray" TextWrapping="Wrap"/>
                </StackPanel>
            </Expander>

            <!-- Follower Settings -->
            <Expander Header="Follower Settings" IsExpanded="False" Margin="5">
                <StackPanel>
                    <Grid Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="Checkbox Color:" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding UI.CheckboxColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 MinWidth="100"
                                 ToolTip="Enter color name (Orange, LimeGreen, Yellow, Cyan, White, Gold, etc.) or hex code (#FF6600)"/>
                    </Grid>
           <WrapPanel Margin="0,5,0,0">
                <Label Content="Follow Distance:"/>
                <Label Content="min"/>
                <TextBox Text="{Binding Path=Follow.FollowDistance, Mode=TwoWay}"
                         MinWidth="25"
                         MaxWidth="50"
                         ToolTip="Min follow distance. the follower will try to keep a random distance from the leader between min and max follow distance."/>
                <Label Content="max"/>
                <TextBox Text="{Binding Path=Follow.MaxFollowDistance, Mode=TwoWay}"
                         MinWidth="25"
                         MaxWidth="50"
                         ToolTip="Max follow distance. the follower will try to keep a random distance from the leader between min and max follow distance."/>
                    </WrapPanel>

                    <Label Content="Party role:   "></Label>
                    <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Row="0"
                        Grid.Column="0"
                        Content="Kill Monsters"
                        Margin="10,0,10,0"
                        IsChecked="{Binding Path=Combat.ShouldKill, Mode=TwoWay}"
                        VerticalAlignment="Center"
                        ToolTip="Should the Follower use the Routine configured skills to fight?"/>
                <Label Grid.Row="0"
                        Grid.Column="1"
                        Content="Max combat Distance:"
                        VerticalAlignment="Center"/>
                <TextBox Grid.Row="0"
                        Grid.Column="2"
                        Text="{Binding Path=Follow.MaxCombatDistance, Mode=TwoWay}"
                        MinWidth="25"
                        MaxWidth="50"
                        VerticalAlignment="Center"
                        ToolTip="Max distance from the leader, the follower will consider a mob targhetable and so try to fight."/>

                <CheckBox Grid.Row="1"
                        Grid.Column="0"
                        Content="Loot Visible Items"
                        Margin="10,0,10,0"
                        IsChecked="{Binding Path=Loot.ShouldLoot, Mode=TwoWay}"
                        VerticalAlignment="Center"
                        ToolTip="Should the Follower try to loot ALL visible items? PLS NOTE: you nee to use a ingame item filter to reduce the quantity of visible items."/>
                <Label Grid.Row="1"
                        Grid.Column="1"
                        Content="Max loot Distance:"
                        VerticalAlignment="Center"/>
                <TextBox Grid.Row="1"
                        Grid.Column="2"
                        Text="{Binding Path=Follow.MaxLootDistance, Mode=TwoWay}"
                        MinWidth="25"
                        MaxWidth="50"
                        VerticalAlignment="Center"
                        ToolTip="Max distance from the leader, the follower is allowed to move to loot items. All Items above this distance, will be logged and ignored."/>

                <CheckBox
                    Grid.Row="2"
                    Grid.Column="0"
                    Margin="10,0,10,0"
                    Content="Loot only quest items"
                    VerticalAlignment="Center"
                    IsChecked="{Binding Path=Loot.ShouldLootOnlyQuestItem, Mode=TwoWay}"
                    ToolTip="Work if enable Loot visible item."/>
                <CheckBox
                    Grid.Row="3"
                    Grid.Column="0"
                    Margin="10,0,10,0"
                    Content="Enable Quest Handling"
                    VerticalAlignment="Center"
                    IsChecked="{Binding Path=Follow.InteractQuest, Mode=TwoWay}"
                    ToolTip="Interact quest object and npc"/>
                <CheckBox
                    Grid.Row="4"
                    Grid.Column="0"
                    Margin="10,0,10,0"
                    Content="Open Chests"
                    VerticalAlignment="Center"
                    IsChecked="{Binding Path=Loot.ShouldOpenChests, Mode=TwoWay}"
                    ToolTip="Open nearby chests while following."/>
                <CheckBox
                    Grid.Row="5"
                    Grid.Column="0"
                    Margin="10,0,10,0"
                    Content="Click Shrines"
                    VerticalAlignment="Center"
                    IsChecked="{Binding Path=Follow.ClickShrines, Mode=TwoWay}"
                    ToolTip="Click nearby shrines while following."/>
                <CheckBox
                    Grid.Row="5"
                    Grid.Column="1"
                    Margin="10,0,10,0"
                    Content="Activate Mirage Spawners"
                    VerticalAlignment="Center"
                    IsChecked="{Binding Path=Follow.ActivateMirageSpawners, Mode=TwoWay}"
                    ToolTip="Run through nearby Mirage spawners to trigger monster packs."/>
                <TextBox Grid.Row="5"
                    Grid.Column="2"
                    Text="{Binding Path=Follow.MirageSpawnerDistance, Mode=TwoWay}"
                    MinWidth="25"
                    MaxWidth="50"
                    VerticalAlignment="Center"
                    ToolTip="Max distance to detour for a Mirage spawner."/>

                <CheckBox
                    Grid.Row="6"
                    Grid.Column="0"
                    Margin="10,0,10,0"
                    Content="Use Stalker Sentinel"
                    IsChecked="{Binding Path=Combat.UseStalkerSentinel, Mode=TwoWay}"
                    VerticalAlignment="Center"
                    ToolTip="Use the Stalker Sentinel if equipped and have charged."/>
                <CheckBox Grid.Row="7"
                          Grid.Column="0"
                          Content="Don't Port Out of Map"
                          Margin="10,0,10,0"
                          IsChecked="{Binding Path=Follow.DontPortOutofMap, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          ToolTip="If Enabled, the follower will not try to exit a map if the Leader die or leave the area, you will need to use chat command to leave the area."
                        Grid.ColumnSpan="3"/>
                <CheckBox Grid.Row="8"
                          Grid.Column="0"
                          Content="Follow in Town"
                          Margin="10,0,10,0"
                          IsChecked="{Binding Path=Follow.FollowInTown, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          ToolTip="If Enabled, the follower will follow the leader in town."/>
               <CheckBox Grid.Row="9"
                         Grid.Column="0"
                         Content="Follow in Hideout"
                         Margin="10,0,10,0"
                         IsChecked="{Binding Path=Follow.FollowInHideout, Mode=TwoWay}"
                         VerticalAlignment="Center"
                         ToolTip="If Enabled, the follower will follow the leader in hideout."/>
               <CheckBox Grid.Row="10"
                          Grid.Column="0"
                          Content="Follow in Heist Hub"
                          Margin="10,0,10,0"
                          IsChecked="{Binding Path=Follow.FollowInHeistHub, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          ToolTip="If Enabled, the follower will follow the leader in Heist Hub."/>
                <CheckBox Grid.Row="11"
                          Grid.Column="0"
                          Grid.ColumnSpan="3"
                          Margin="10,5,10,5"
                          IsChecked="{Binding Follow.AutoReloadPathfinder, Mode=TwoWay}"
                          Content="Auto-Reload Pathfinder on Terrain Change (Keep Off)"
                          ToolTip="It is recommended to keep this setting off. Only enable it if you encounter blockades that the bot should be able to move through."/>

                    </Grid>

                    <WrapPanel Margin="5">
                        <Label Content="Teleport Out delay: "
                                ToolTip="If the Leader Leave the zone for some reason, the bot will wait this numbr of seconds before to leave the map."/>
                        <Slider Name="SlPortOutDelay"
                                Minimum="0"
                                Margin="0,5,0,0"
                                Width="160"
                                Value="{Binding Path=Follow.PortOutThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                SmallChange="1"
                                LargeChange="1"
                                Maximum="100"
                                AutoToolTipPrecision="1"
                                VerticalAlignment="Center"
                                ToolTip="If the Leader Leave the zone for some reason, the bot will wait this numbr of seconds before to leave the map."/>
                        <TextBox Name="TbPortOutDelay"
                                Text="{Binding ElementName=SlPortOutDelay, Path=Value}"
                                Width="40"
                                HorizontalAlignment="Left"
                                Margin="0,5,0,0"
                                VerticalAlignment="Center"
                                ToolTip="If the Leader Leave the zone for some reason, the bot will wait this numbr of seconds before to leave the map."/>
                        <Label Content="Seconds."
                                ToolTip="If the Leader Leave the zone for some reason, the bot will wait this numbr of seconds before to leave the map."/>
                    </WrapPanel>
                </StackPanel>
            </Expander>

            <!-- Passive Tree Settings (EXPERIMENTAL) -->
            <Expander Header="Passive Tree Settings (EXPERIMENTAL)" IsExpanded="False" Margin="5">
                <StackPanel Margin="5">
                    <CheckBox Content="Automatically Allocate Nodes"
                              IsChecked="{Binding PassiveTree.EnableAutoAllocation, Mode=TwoWay}"
                              Margin="5"
                              ToolTip="Automatically spend available passive points based on the provided URLs."/>
                    
                    <StackPanel Margin="25,0,0,0">
                        <CheckBox Content="Allocate only in Town/Hideout"
                                  IsChecked="{Binding PassiveTree.OnlyInSafeZone, Mode=TwoWay}"
                                  Margin="5"
                                  IsEnabled="{Binding PassiveTree.EnableAutoAllocation}"
                                  ToolTip="If enabled, the bot will only interact with the passive tree when in a safe zone."/>

                        <CheckBox Content="Wait for Leader to be Stationary"
                                  IsChecked="{Binding PassiveTree.CheckLeaderStationary, Mode=TwoWay}"
                                  Margin="5"
                                  IsEnabled="{Binding PassiveTree.EnableAutoAllocation}"
                                  ToolTip="If enabled, the bot will wait until the leader is not moving before opening the passive tree in a map."/>
                        
                        <StackPanel Orientation="Horizontal" Margin="5">
                            <Label Content="Safe Monster Distance:" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding PassiveTree.SafeMonsterDistance, Mode=TwoWay}"
                                     Width="50" Margin="5,0,0,0" VerticalAlignment="Center"
                                     ToolTip="Minimum distance to the nearest monster before the bot considers it safe to open the tree."/>
                        </StackPanel>
                    </StackPanel>

                    <Label Content="Passive Tree URLs (Sequenced):" FontWeight="Bold" Margin="0,10,0,5"/>
                    <ItemsControl ItemsSource="{Binding PassiveTree.PassiveTreeUrls}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Path=Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,5,0"
                                             ToolTip="Enter Official PoE or PoePlanner URL."/>
                                    <Button Grid.Column="1" Content="Remove"
                                            Click="RemovePassiveTreeUrl_Click"
                                            Padding="5,2"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    
                    <Button Content="Add New URL"
                            Click="AddPassiveTreeUrl_Click"
                            Margin="0,5,0,0" HorizontalAlignment="Left"
                            Padding="10,5"/>

                    <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                        <Label Content="Allocation Chat Command:" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding ChatCommands.AllocateChatCommand, Mode=TwoWay}"
                                 Width="120" Margin="5,0,0,0" VerticalAlignment="Center"
                                 ToolTip="Command to manually trigger allocation (ignoring safe zone/stationary checks)."/>
                    </StackPanel>
                </StackPanel>
            </Expander>

            <!-- Invite/Trade Whitelist -->
            <Expander Header="Invite/Trade Whitelist" IsExpanded="False" Margin="5">
                <StackPanel VerticalAlignment="Top" Margin="0,5,0,0">
                    <TextBlock Text="Manage allowed account names (name#1234) or character names for party invites and trades."
                               Margin="5" FontStyle="Italic" Foreground="Gray"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Row="0"
                               Grid.Column="0"
                               Content="Name to Add: "
                               Margin="3"
                               ToolTipService.ToolTip="Enter an account name (name#1234) or character name to add to the whitelist."/>
                        <TextBox x:Name="InviteTradeWhiteListTextBox"
                                 Grid.Row="0"
                                 Grid.Column="1"
                                 Width="160"/>
                        <Button x:Name="AddInviteTradeWhiteListButton"
                                Grid.Row="0"
                                Grid.Column="2"
                                Content="Add"
                                Margin="3,5,3,1"
                                ToolTipService.ToolTip="Adds the name to the whitelist. Use account name (name#1234) or character name."
                                Click="AddInviteTradeWhiteListButton_OnClick"/>
                        <Button x:Name="RemoveInviteTradeWhiteListButton"
                                Grid.Row="0"
                                Grid.Column="3"
                                Content="Remove"
                                Margin="3,5,3,1"
                                ToolTipService.ToolTip="Removes the selected name from the whitelist."
                                Click="RemoveInviteTradeWhiteListButton_OnClick"/>

                        <Label Grid.Row="1"
                               Grid.Column="0"
                               Content="Whitelist: "
                               Margin="3"
                               ToolTipService.ToolTip="Names allowed to send party invites and trade requests."/>
                        <ListBox x:Name="InviteTradeWhiteListListBox"
                                 Grid.Row="1"
                                 Grid.Column="1"
                                 Grid.ColumnSpan="3"
                                 ItemsSource="{Binding Path=Follow.PartyAndTradeWhitelist, Mode=TwoWay}"
                                 SelectionChanged="InviteTradeWhiteListListBox_SelectionChanged"
                                 MinHeight="100"/>
                    </Grid>
                </StackPanel>
            </Expander>

            <!-- Loot Blacklist -->
            <Expander Header="Loot Blacklist" IsExpanded="False" Margin="5">
                <StackPanel VerticalAlignment="Top" Margin="5">
                    <TextBlock Text="Prevent specific items from being picked up, even if visible."
                               Margin="5" FontStyle="Italic" Foreground="Gray" TextWrapping="Wrap"/>

                    <Grid Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Type Selection -->
                        <Label Grid.Row="0" Grid.Column="0" Content="Type:" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="3">
                            <RadioButton x:Name="BlacklistByName" Content="By Name" IsChecked="True"
                                         GroupName="BlacklistType" Margin="0,0,15,0"
                                         ToolTip="Block by display name (e.g., 'Scroll of Wisdom')"/>
                            <RadioButton x:Name="BlacklistByMetadata" Content="By Metadata"
                                         GroupName="BlacklistType"
                                         ToolTip="Block by metadata (e.g., 'Metadata/Items/Currency/CurrencyIdentification')"/>
                        </StackPanel>

                        <!-- Input Field -->
                        <Label Grid.Row="1" Grid.Column="0" Content="Item:" VerticalAlignment="Center"/>
                        <TextBox x:Name="LootBlacklistTextBox" Grid.Row="1" Grid.Column="1"
                                 MinWidth="200" Margin="3" VerticalAlignment="Center"/>

                        <!-- Action Buttons -->
                        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="3">
                            <Button x:Name="AddLootBlacklistButton" Content="Add" MinWidth="60"
                                    Margin="0,0,3,0" Click="AddLootBlacklistButton_OnClick"
                                    ToolTip="Add to blacklist"/>
                            <Button x:Name="RemoveLootBlacklistButton" Content="Remove" MinWidth="60"
                                    Click="RemoveLootBlacklistButton_OnClick"
                                    ToolTip="Remove selected from blacklist"/>
                        </StackPanel>

                        <!-- Blacklist Display -->
                        <Label Grid.Row="2" Grid.Column="0" Content="Blacklist:"
                               VerticalAlignment="Top" Margin="0,5,0,0"/>
                        <ListBox x:Name="LootBlacklistListBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                 MinHeight="100" MaxHeight="200" Margin="3,5,3,3"
                                 ItemsSource="{Binding Path=Loot.LootBlacklist, Mode=TwoWay}"
                                 SelectionChanged="LootBlacklistListBox_SelectionChanged"/>

                        <!-- Examples -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="5"
                                   FontSize="10" Foreground="Gray" TextWrapping="Wrap">
                            <Run Text="Examples: "/>
                            <LineBreak/>
                            <Run Text="• Name: 'Scroll of Wisdom', 'Portal Scroll'"/>
                            <LineBreak/>
                            <Run Text="• Metadata: 'Metadata/Items/Currency/CurrencyIdentification'"/>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Expander>

            <!-- Ultimatum -->
            <Expander Header="Ultimatum Settings" IsExpanded="False" Margin="5">
                <StackPanel>
                    <CheckBox Content="Portal After Ultimatum" IsChecked="{Binding Loot.ShouldLootUltimatum, Mode=TwoWay}" ToolTip="If enabled, the bot will search for a portal for a configurable amount of time after an Ultimatum is completed."/>
                    <WrapPanel>
                        <Label Content="Portal Search Time: "/>
                        <Slider Name="SlUltimatumLootTimer" Minimum="1" Maximum="60" Value="{Binding Loot.UltimatumLootTimer, Mode=TwoWay}" Width="150" TickFrequency="1" IsSnapToTickEnabled="True"/>
                        <TextBox Text="{Binding ElementName=SlUltimatumLootTimer, Path=Value}" Width="30"/>
                        <Label Content="seconds"/>
                    </WrapPanel>
                </StackPanel>
            </Expander>

            <!-- Trade Settings -->
            <Expander Header="Trade Settings" IsExpanded="False" Margin="5">
                <StackPanel>
                    <CheckBox Content="Enable Trade Debug Log"
                              IsChecked="{Binding Trade.EnableTradeDebugLog, Mode=TwoWay}"
                              Margin="5"
                              ToolTip="If enabled, detailed trade logs will be shown for debugging purposes."/>
                    <Expander Header="Exclude Specific Inventory Slots" IsExpanded="False" Margin="5">
                        <StackPanel>
                            <TextBlock Text="Check slots to exclude from trading (items will be kept):"
                                       Margin="5" FontWeight="SemiBold"/>
                            <TextBlock Text="Useful for protecting flasks, currency, or important items"
                                       FontStyle="Italic" Foreground="Gray" Margin="5,0,5,5"/>

                            <!-- 12x5 Inventory Grid -->
                            <Grid Name="TradeSlotGrid" HorizontalAlignment="Center" Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="20"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="20"/>
                                    <RowDefinition Height="20"/>
                                    <RowDefinition Height="20"/>
                                    <RowDefinition Height="20"/>
                                    <RowDefinition Height="20"/>
                                </Grid.RowDefinitions>
                                <!-- Checkboxes will be generated in code-behind -->
                            </Grid>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10,5">
                                <Button Content="Clear All" Width="80" Height="25" Margin="3" Click="ClearAllSlots_Click"/>
                                <Button Content="Exclude Left Column" Width="120" Height="25" Margin="3" Click="ExcludeLeftColumn_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Expander>

            <!-- Lab Settings -->
            <Expander Header="Lab Settings" IsExpanded="False" Margin="5">
                <StackPanel>
                    <CheckBox Content="Enable Divine Font Handling"
                              IsChecked="{Binding Lab.EnableDivineFontHandling, Mode=TwoWay}"
                              Margin="5"
                              ToolTip="If enabled, the bot will handle Divine Font interactions in the Labyrinth."/>

                    <TextBlock Text="Gem Selection Strategy:" Margin="5,10,5,5" FontWeight="SemiBold"/>

                    <RadioButton Content="Use First Inventory Slot"
                                 IsChecked="{Binding Lab.UseFirstInventorySlot, Mode=TwoWay}"
                                 GroupName="GemStrategy"
                                 Margin="15,5,5,5"
                                 ToolTip="Always use the gem in the first inventory slot for the Divine Font."/>

                    <RadioButton Content="Search for Suitable Gem"
                                 IsChecked="{Binding Lab.SearchForSuitableGem, Mode=TwoWay}"
                                 GroupName="GemStrategy"
                                 Margin="15,5,5,5"
                                 ToolTip="Search inventory for the most suitable gem based on value and type."/>

                     <StackPanel Orientation="Horizontal" Margin="15,5,5,5">
                         <Label Content="Gem Value Safety Threshold:" VerticalAlignment="Center"
                                ToolTip="Don't use gems for transformation if their potential value exceeds this threshold (in Chaos Orbs)."/>
                         <controls:NumericUpDown Value="{Binding Lab.GemValueSafetyThreshold, Mode=TwoWay}"
                                                 Minimum="0" Maximum="100" Interval="1" Width="90"
                                                 VerticalAlignment="Center"/>
                     </StackPanel>
                     <StackPanel Orientation="Horizontal" Margin="15,5,5,5">
                         <Label Content="Gem Color to Use:" VerticalAlignment="Center"
                                ToolTip="Select the color of the gem to use for the Divine Font."/>
                         <ComboBox x:Name="GemColorComboBox" Width="120"
                                   SelectedItem="{Binding Lab.Color, Mode=TwoWay}"
                                   SelectionChanged="GemColorComboBox_SelectionChanged"/>
                         <Button x:Name="TestSmartLogicButton" Content="Test Smart Logic"
                                 Width="120" Margin="10,0,0,0" VerticalAlignment="Center"
                                 Click="TestSmartLogicButton_Click"
                                 Visibility="Collapsed"
                                 ToolTip="Test the smart gem selection logic and see which gem color will be chosen."/>
                     </StackPanel>

                     <!-- Stash Tab Configuration -->
                     <GroupBox Header="Stash Tab Settings" Margin="5">
                         <StackPanel>
                             <StackPanel Orientation="Horizontal" Margin="5">
                                 <RadioButton Content="Use Tab Index"
                                              IsChecked="{Binding Lab.TabMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Index}"
                                              GroupName="StashTabMode" Margin="0,0,15,0"/>
                                 <RadioButton Content="Use Tab Name"
                                              IsChecked="{Binding Lab.TabMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Name}"
                                              GroupName="StashTabMode"/>
                             </StackPanel>

                             <StackPanel Orientation="Horizontal" Margin="5">
                                 <Label Content="Tab Index:" VerticalAlignment="Center" Width="70"/>
                                 <controls:NumericUpDown Value="{Binding Lab.StashTabIndex, Mode=TwoWay}"
                                                       Minimum="0" Maximum="100" Width="100"
                                                       IsEnabled="{Binding Lab.TabMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Index}"/>
                             </StackPanel>

                             <StackPanel Orientation="Horizontal" Margin="5">
                                 <Label Content="Tab Name:" VerticalAlignment="Center" Width="70"/>
                                 <TextBox Text="{Binding Lab.StashTabName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="150"
                                          IsEnabled="{Binding Lab.TabMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Name}"/>
                             </StackPanel>
                         </StackPanel>
                     </GroupBox>

                     <!-- Divine Font Options Priority List -->
                     <Separator Margin="5,10,5,10"/>
                     <TextBlock Text="Divine Font Options Priority:" Margin="5,5,5,5" FontWeight="SemiBold"
                               ToolTip="Configure which Divine Font options to use and their priority order (1 = highest priority)."/>

                     <Border BorderBrush="Gray" BorderThickness="1" Margin="5" Padding="5">
                         <ListBox x:Name="DivineFontOptionsListBox"
                                 ItemsSource="{Binding Lab.DivineFontOptions, Mode=TwoWay}"
                                 MinHeight="150" MaxHeight="300"
                                 SelectionChanged="DivineFontOptionsListBox_SelectionChanged"
                                 HorizontalContentAlignment="Stretch">
                             <ListBox.ItemTemplate>
                                 <DataTemplate>
                                     <Grid Margin="2">
                                         <Grid.RowDefinitions>
                                             <RowDefinition Height="Auto"/>
                                             <RowDefinition Height="Auto"/>
                                         </Grid.RowDefinitions>
                                         <Grid.ColumnDefinitions>
                                             <ColumnDefinition Width="Auto"/>
                                             <ColumnDefinition Width="Auto"/>
                                             <ColumnDefinition Width="*"/>
                                             <ColumnDefinition Width="Auto"/>
                                             <ColumnDefinition Width="Auto"/>
                                         </Grid.ColumnDefinitions>

                                         <!-- Row 1: Main option controls -->
                                         <!-- Enable/Disable Checkbox -->
                                         <CheckBox Grid.Row="0" Grid.Column="0"
                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                  Margin="0,0,10,0"
                                                  ToolTip="Enable or disable this option"/>

                                         <!-- Priority -->
                                         <TextBlock Grid.Row="0" Grid.Column="1"
                                                   Text="{Binding Priority, StringFormat='Priority: {0}'}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0"
                                                   MinWidth="70"/>

                                         <!-- Option Name/Description -->
                                         <TextBlock Grid.Row="0" Grid.Column="2"
                                                   Text="{Binding Name}"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"/>

                                         <!-- Move Up Button -->
                                         <Button Grid.Row="0" Grid.Column="3" Content="▲"
                                                Width="25" Height="25"
                                                Margin="5,0,2,0"
                                                Click="MoveDivineFontOptionUp_Click"
                                                ToolTip="Move up in priority"/>

                                         <!-- Move Down Button -->
                                         <Button Grid.Row="0" Grid.Column="4" Content="▼"
                                                Width="25" Height="25"
                                                Margin="2,0,0,0"
                                                Click="MoveDivineFontOptionDown_Click"
                                                ToolTip="Move down in priority"/>

                                         <!-- Row 2: Gem Name Input (visible only for TransformSpecificGem type) -->
                                         <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5"
                                                    Orientation="Horizontal"
                                                    Margin="35,5,0,0">
                                             <StackPanel.Style>
                                                 <Style TargetType="StackPanel">
                                                     <Setter Property="Visibility" Value="Collapsed"/>
                                                     <Style.Triggers>
                                                         <DataTrigger Binding="{Binding Type}" Value="TransformSpecificGem">
                                                             <Setter Property="Visibility" Value="Visible"/>
                                                         </DataTrigger>
                                                     </Style.Triggers>
                                                 </Style>
                                             </StackPanel.Style>
                                             <Label Content="Gem Name:" VerticalAlignment="Center"/>
                                             <TextBox Text="{Binding GemName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="200"
                                                     Margin="5,0,0,0"
                                                     ToolTip="Enter the exact name of the skill gem (e.g., 'Cleave', 'Arc')"/>
                                         </StackPanel>
                                     </Grid>
                                 </DataTemplate>
                             </ListBox.ItemTemplate>
                         </ListBox>
                     </Border>
              </StackPanel>
          </Expander>

            <!-- Stash Settings -->
            <Expander Header="Stash Settings" IsExpanded="False" Margin="5">
                <StackPanel>
                    <TextBlock Text="Configure automatic stashing behavior."
                               Margin="5" FontStyle="Italic" Foreground="Gray" TextWrapping="Wrap"/>

                    <CheckBox Content="Auto-deposit on Map Exit"
                              IsChecked="{Binding Stash.AutoDepositOnMapExit, Mode=TwoWay}"
                              Margin="5"
                              ToolTip="Automatically deposit inventory to stash when exiting a map to hideout."/>

                    <GroupBox Header="Stash Type" Margin="5">
                        <StackPanel Orientation="Horizontal" Margin="5">
                            <RadioButton Content="Regular Stash"
                                         IsChecked="{Binding Stash.UseGuildStash, Converter={StaticResource InverseBoolConverter}}"
                                         GroupName="StashType"
                                         Margin="0,0,20,0"
                                         ToolTip="Use the regular stash for depositing items"/>
                            <RadioButton Content="Guild Stash"
                                         IsChecked="{Binding Stash.UseGuildStash, Mode=TwoWay}"
                                         GroupName="StashType"
                                         ToolTip="Use the guild stash for depositing items"/>
                        </StackPanel>
                    </GroupBox>

                    <StackPanel Orientation="Horizontal" Margin="5">
                        <Label Content="Target Stash Tab:" VerticalAlignment="Center" Width="120"
                               ToolTip="Name of the stash tab to deposit items into (e.g., 'Dump', 'Currency')"/>
                        <TextBox Text="{Binding Stash.TargetStashTab, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Width="200"
                                 ToolTip="Items will be deposited to this tab. Stash affinities will auto-route currency, maps, etc."/>
                    </StackPanel>

                    <TextBlock Text="Note: With stash affinities enabled, currency and maps will automatically go to their designated tabs."
                               Margin="5,10,5,0" FontSize="10" FontStyle="Italic" Foreground="Gray" TextWrapping="Wrap"/>
                    <TextBlock Text="You MUST check 'Enable Tab Affinities' and UNCHECK 'Affinity Auto-navigation' in the game's Stash Options (Gear Icon), or the bot will fail to stash items correctly!"
                               Margin="5,5,5,5" FontSize="11" FontWeight="Bold" Foreground="IndianRed" TextWrapping="Wrap"/>
                </StackPanel>
            </Expander>

      </StackPanel>
    </ScrollViewer>

</UserControl>
